{
  "定義（Definition）": {
    "prefix": "def",
    "body": [
      "<Definition id=\"${1:id}\" category=\"${2:分野}\" title=\"${3:定義名}\">",
      "\t$0",
      "</Definition>"
    ],
    "description": "定義のブロック。id / category / title は必須。tags と label は任意で足せる"
  },
  "定理（Theorem）": {
    "prefix": "thm",
    "body": [
      "<Theorem id=\"${1:id}\" category=\"${2:分野}\" title=\"${3:定理名}\">",
      "\t$0",
      "</Theorem>"
    ],
    "description": "定理のブロック。id / category / title は必須。tags と label は任意で足せる"
  },
  "補題（Lemma）": {
    "prefix": "lem",
    "body": [
      "<Lemma id=\"${1:id}\" category=\"${2:分野}\" title=\"${3:補題名}\">",
      "\t$0",
      "</Lemma>"
    ],
    "description": "補題のブロック。id / category / title は必須。tags と label は任意で足せる"
  },
  "系（Corollary）": {
    "prefix": "cor",
    "body": [
      "<Corollary id=\"${1:id}\" category=\"${2:分野}\" title=\"${3:系名}\">",
      "\t$0",
      "</Corollary>"
    ],
    "description": "系のブロック。id / category / title は必須。tags と label は任意で足せる"
  },
  "命題（Proposition）": {
    "prefix": "prop",
    "body": [
      "<Proposition id=\"${1:id}\" category=\"${2:分野}\" title=\"${3:命題名}\">",
      "\t$0",
      "</Proposition>"
    ],
    "description": "命題のブロック。id / category / title は必須。tags と label は任意で足せる"
  },
  "公理（Axiom）": {
    "prefix": "ax",
    "body": [
      "<Axiom id=\"${1:id}\" category=\"${2:分野}\" title=\"${3:公理名}\">",
      "\t$0",
      "</Axiom>"
    ],
    "description": "公理のブロック。id / category / title は必須。tags と label は任意で足せる"
  },
  "例（Example）": {
    "prefix": "ex",
    "body": [
      "<Example title=\"${1:例}\">",
      "\t$0",
      "</Example>"
    ],
    "description": "例のブロック。title は省略可"
  },
  "注意（Remark）": {
    "prefix": "rem",
    "body": [
      "<Remark title=\"${1:注意}\">",
      "\t$0",
      "</Remark>"
    ],
    "description": "注意のブロック。title は省略可"
  },
  "参考（Confer）": {
    "prefix": "cf",
    "body": [
      "<Confer title=\"${1:参考}\">",
      "\t$0",
      "</Confer>"
    ],
    "description": "参考のブロック。title は省略可"
  },
  "証明（Proof）": {
    "prefix": "proof",
    "body": [
      "<Proof title=\"${1:証明}\">",
      "\t$0",
      "</Proof>"
    ],
    "description": "証明のブロック。折りたたみ。defaultOpen を足すと開いた状態で出る"
  },
  "解答（Solution）": {
    "prefix": "sol",
    "body": [
      "<Solution title=\"${1:解答}\">",
      "\t$0",
      "</Solution>"
    ],
    "description": "解答のブロック。折りたたみ。defaultOpen を足すと開いた状態で出る"
  },
  "Box: 枠": {
    "prefix": "box",
    "body": [
      "<Box label=\"${1:ラベル}\">",
      "\t$0",
      "</Box>"
    ],
    "description": "左上にラベルを出す枠。ラベル不要なら label ごと消す"
  },
  "Box: 枠（色付き）": {
    "prefix": "box-accent",
    "body": [
      "<Box label=\"${1:ラベル}\" accent=\"${2:#0071e3}\">",
      "\t$0",
      "</Box>"
    ],
    "description": "枠線とラベルに色を付ける。値は #0071e3 / var(--link-color) / #16a34a など"
  },
  "Callout: 補足": {
    "prefix": "callout-note",
    "body": [
      "<CalloutNote title=\"${1:補足}\">",
      "\t$0",
      "</CalloutNote>"
    ],
    "description": "補足の吹き出し（title は省略可）"
  },
  "Callout: コツ": {
    "prefix": "callout-tip",
    "body": [
      "<CalloutTip title=\"${1:コツ}\">",
      "\t$0",
      "</CalloutTip>"
    ],
    "description": "コツの吹き出し（title は省略可）"
  },
  "Callout: 注意": {
    "prefix": "callout-warn",
    "body": [
      "<CalloutWarning title=\"${1:注意}\">",
      "\t$0",
      "</CalloutWarning>"
    ],
    "description": "注意の吹き出し（title は省略可）"
  },
  "Figure: 画像とキャプション": {
    "prefix": "fig",
    "body": [
      "<Figure src=\"${1:/images/}\" alt=\"${2:代替テキスト}\" caption=\"${3:キャプション}\" />$0"
    ],
    "description": "キャプション付きの画像"
  },
  "LinkCard: リンクカード": {
    "prefix": "linkcard",
    "body": [
      "<LinkCard url=\"${1:https://}\" />$0"
    ],
    "description": "URL をカード状に表示する"
  },
  "LinkPreview: リンクの下敷き": {
    "prefix": "linkprev",
    "body": [
      "<LinkPreview url=\"${1:https://}\" />$0"
    ],
    "description": "リンク先の内容を先読みして見せる"
  },
  "Embed: 埋め込み": {
    "prefix": "embed",
    "body": [
      "<Embed src=\"${1:https://}\" title=\"${2:タイトル}\" aspectRatio=\"${3:16/9}\" />$0"
    ],
    "description": "任意の iframe を比率つきで埋め込む"
  },
  "YouTube: 動画": {
    "prefix": "youtube",
    "body": [
      "<YouTubeEmbed id=\"${1:動画ID}\" />$0"
    ],
    "description": "YouTube の動画を埋め込む"
  },
  "Spacer: 余白": {
    "prefix": "spacer",
    "body": [
      "<Spacer size=\"${1:md}\" />$0"
    ],
    "description": "縦の余白を空ける（sm / md / lg）"
  },
  "Indent: 字下げ": {
    "prefix": "indent",
    "body": [
      "<Indent level={${1:1}}>",
      "\t$0",
      "</Indent>"
    ],
    "description": "段落を字下げする"
  },
  "InlineToc: 目次": {
    "prefix": "toc",
    "body": [
      "<InlineToc />$0"
    ],
    "description": "本文中に目次を差し込む"
  },
  "コードブロック": {
    "prefix": "code",
    "body": [
      "```${1:ts}",
      "$0",
      "```"
    ],
    "description": "言語を指定したコードブロック"
  },
  "詳細（折りたたみ）": {
    "prefix": "details",
    "body": [
      "<details>",
      "<summary>${1:見出し}</summary>",
      "",
      "$0",
      "",
      "</details>"
    ],
    "description": "クリックで開く折りたたみ"
  },
  "表": {
    "prefix": "table",
    "body": [
      "| ${1:見出し} | ${2:見出し} |",
      "|---|---|",
      "| $3 | $4 |",
      "$0"
    ],
    "description": "2列の表"
  }
}